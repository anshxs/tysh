		"textPreformat.foreground": "#333333",
		"textPreformat.background": "#EEEEEE",
		"textSeparator.foreground": "#E5E5E5",
		"titleBar.activeBackground": "#FFFFFF",
		"titleBar.activeForeground": "#111111",
		"titleBar.border": "#E5E5E5",
		"titleBar.inactiveBackground": "#FFFFFF",
		"titleBar.inactiveForeground": "#888888",
		"welcomePage.tileBackground": "#F7F7F7",
		"welcomePage.progress.foreground": "#000000",
		"widget.border": "#E5E5E5",
		"modernActivityBarItem.activeBackground": "#00000010",
		"modernActivityBarItem.hoverBackground": "#00000008",
		"modernActivityBar.border": "#E5E5E5"
