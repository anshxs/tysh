		"statusBar.noFolderBackground": "#FFFFFF",
		"statusBarItem.focusBorder": "#CCCCCC",
		"statusBarItem.prominentBackground": "#F0F0F0",
		"statusBarItem.remoteBackground": "#00000000",
		"statusBarItem.remoteForeground": "#111111",
